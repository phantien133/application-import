# Copy to .env and adjust: `cp .env.example .env`
# .env is git-ignored. It is read by:
#   - docker compose (variable interpolation in compose.yaml)
#   - Rails on the host via the dotenv gem (development/test only)
# Real environment variables always win over values in this file.

# --- Docker Compose ----------------------------------------------------------
# Unique per project: prefixes containers, network and volumes so several
# projects can run side by side.
COMPOSE_PROJECT_NAME=dwf

# Host interface the ports are published on (127.0.0.1 = not reachable from LAN).
DWF_BIND_HOST=127.0.0.1

# Host ports = standard port with a per-project prefix digit, so projects
# do not collide (this project: 1 => 13000 / 15432 / 16379; another project
# could use 2xxxx or 4xxxx). Without .env the standard ports are used.
# Containers keep their internal ports (Postgres 5432, Redis 6379).
DWF_RAILS_PORT=13000
DWF_DB_PORT=15432
DWF_REDIS_PORT=16379

# --- Rails (when running on the host: `bin/dev`, `bin/rspec`) -----------
# Inside the compose `web` container these are overridden to point at the
# `db` and `redis` services.
PORT=${DWF_RAILS_PORT}

DB_HOST=127.0.0.1
DB_PORT=${DWF_DB_PORT}
DB_USERNAME=postgres
DB_PASSWORD=postgres

REDIS_URL=redis://127.0.0.1:${DWF_REDIS_PORT}/0
# Optional: separate Redis (or db index) for Rails.cache, falls back to REDIS_URL
# REDIS_CACHE_URL=redis://127.0.0.1:${DWF_REDIS_PORT}/1

RAILS_MAX_THREADS=5
